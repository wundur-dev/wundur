#!/bin/sh
# after-merge: run after a PR merges on main. Runs from anywhere in the repo.
#
# 1. Pulls main into the root checkout (fast-forward only). Stops if the root is not on main or
#    the pull fails.
# 2. After a successful pull, removes each worktree in .worktrees/ that is finished: no
#    uncommitted changes, no running process inside it (another session may still be there), and
#    its tip is exactly the head commit of a merged PR. Branch names get reused for later PRs, so
#    a merged PR under the same name is not enough: new commits since then keep the worktree.
#    Then its branch is deleted; everything on it is in the merged PR. Anything it cannot confirm
#    is kept.
# 3. Restarts Wundur only if the pull brought changes. When main was already up to date, nothing
#    restarts. To restart without pulling, run ./scripts/restart from the root checkout.

ROOT=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)") || exit 1
cd "$ROOT" || exit 1

branch=$(git branch --show-current)
if [ "$branch" != main ]; then
    echo "The root checkout is on '$branch', not main: nothing pulled, removed or restarted."
    exit 1
fi

before=$(git rev-parse HEAD)
if ! git pull --ff-only origin main; then
    echo "The pull failed: nothing removed or restarted. Resolve it in $ROOT first."
    exit 1
fi
after=$(git rev-parse HEAD)

for wt in "$ROOT"/.worktrees/*; do
    [ -d "$wt" ] || continue
    name=$(basename "$wt")
    b=$(git -C "$wt" branch --show-current)
    if [ -z "$b" ]; then
        echo "Kept $name: it has no branch."
        continue
    fi
    if [ -n "$(git -C "$wt" status --porcelain)" ]; then
        echo "Kept $name: it has uncommitted changes."
        continue
    fi
    if lsof -a -d cwd -Fn 2>/dev/null | awk -v w="n$wt" 'index($0, w) == 1 { c = substr($0, length(w) + 1, 1); if (c == "" || c == "/") f = 1 } END { exit !f }'; then
        echo "Kept $name: a running process (another session?) is working in it."
        continue
    fi
    tip=$(git -C "$wt" rev-parse HEAD)
    if ! gh pr list --head "$b" --state merged --json headRefOid --jq '.[].headRefOid' 2>/dev/null | grep -qx "$tip"; then
        echo "Kept $name: its tip is not the head of a merged PR for branch $b."
        continue
    fi
    if ! git worktree remove "$wt"; then
        echo "Kept $name: git would not remove it."
        continue
    fi
    echo "Removed $name."
    # Its tip is a merged PR's head, so -D loses nothing, squash merges included.
    git branch -D "$b" >/dev/null && echo "Deleted branch $b."
done

if [ "$before" = "$after" ]; then
    echo "main was already up to date: not restarting."
    exit 0
fi
echo "main moved to $(git rev-parse --short HEAD): restarting Wundur."
exec ./scripts/restart
